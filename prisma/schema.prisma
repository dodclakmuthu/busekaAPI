generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["busapp"]
}

enum CompanyUserRole {
  OWNER
  MANAGER

  @@schema("busapp")
}

enum StaffRoleType {
  DRIVER
  CONDUCTOR
  DRIVER_CONDUCTOR

  @@schema("busapp")
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  DAILY_HIRE
  CONTRACT

  @@schema("busapp")
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD

  @@schema("busapp")
}

enum RouteDirection {
  UP
  DOWN

  @@schema("busapp")
}

enum RouteSourceType {
  GLOBAL
  COMPANY_PRIVATE
  COMPANY_REQUEST

  @@schema("busapp")
}

enum RouteApprovalStatus {
  DRAFT
  PRIVATE_ACTIVE
  PENDING_APPROVAL
  PENDING_UPDATE_APPROVAL
  APPROVED
  REJECTED
  UPDATE_REJECTED

  @@schema("busapp")
}

enum RouteHistoryActionType {
  CREATED
  UPDATED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  REJECTED

  @@schema("busapp")
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  COMPLETED
  CANCELLED

  @@schema("busapp")
}

enum TripStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("busapp")
}

enum ExpenseCategory {
  DIESEL
  EXPRESSWAY
  RUNNER
  PARKING
  MEAL_ALLOWANCE
  REPAIR
  OTHER

  @@schema("busapp")
}

enum ExtraIncomeCategory {
  PARCEL
  BAGGAGE
  OTHER

  @@schema("busapp")
}

enum DailySummaryStatus {
  DRAFT
  SUBMITTED
  APPROVED

  @@schema("busapp")
}

enum WageModel {
  PERCENTAGE
  FIXED

  @@schema("busapp")
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR

  @@schema("busapp")
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  mobileNumber String   @unique
  email        String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  isAppAdmin   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCompanies     Company[]       @relation("CompanyOwner")
  companyUsers       CompanyUser[]
  assignmentsCreated BusAssignment[] @relation("AssignedByUser")
  busPinsCreated     BusAccessPin[]  @relation("PinCreatedByUser")
  summariesApproved  DailySummary[]  @relation("SummaryApprovedByUser")
  routesCreated      Route[]         @relation("RouteCreatedByUser")
  routesReviewed     Route[]         @relation("RouteReviewedByUser")
  routeHistoryChanges RouteHistory[] @relation("RouteHistoryChangedByUser")
  routeHistoryReviews RouteHistory[] @relation("RouteHistoryReviewedByUser")
  notifications      Notification[]  @relation("NotificationUser")

  @@schema("busapp")
}

model Company {
  id           String   @id @default(uuid())
  name         String
  ownerUserId  String
  businessType String   @default("individual_owner")
  mobileNumber String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner         User            @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  companyUsers  CompanyUser[]
  staffProfiles StaffProfile[]
  routes        Route[]
  buses         Bus[]
  assignments   BusAssignment[]
  trips         Trip[]
  operationalExpenses OperationalExpense[]
  operationalIncomes  OperationalIncome[]
  summaries     DailySummary[]
  settings      CompanySettings?
  notifications Notification[]

  @@schema("busapp")
}

model CompanyUser {
  id        String          @id @default(uuid())
  companyId String
  userId    String
  role      CompanyUserRole
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@schema("busapp")
}

model StaffProfile {
  id             String         @id @default(uuid())
  companyId      String
  fullName       String
  mobileNumber   String?
  nicNumber      String?
  roleType       StaffRoleType
  employmentType EmploymentType @default(PERMANENT)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverAssignments    BusAssignment[] @relation("DriverAssignment")
  conductorAssignments BusAssignment[] @relation("ConductorAssignment")
  defaultDriverBuses    Bus[]           @relation("BusDefaultDriver")
  defaultConductorBuses Bus[]           @relation("BusDefaultConductor")
  driverTrips          Trip[]          @relation("TripDriver")
  conductorTrips       Trip[]          @relation("TripConductor")

  @@index([companyId])
  @@index([roleType])
  @@index([isActive])
  @@schema("busapp")
}

model Route {
  id            String   @id @default(uuid())
  companyId     String?
  routeCode     String?
  routeName     String
  startLocation String
  endLocation   String
  description   String?
  distanceKm    Decimal? @db.Decimal(8, 2)
  downIsReverseOfUp Boolean @default(true)
  sourceType    RouteSourceType @default(COMPANY_PRIVATE)
  approvalStatus RouteApprovalStatus @default(PRIVATE_ACTIVE)
  createdByUserId String?
  reviewedByUserId String?
  globalRouteId String?
  approvedSnapshotHash String?
  lastSubmittedAt DateTime?
  lastApprovedAt DateTime?
  requestedAt   DateTime?
  reviewedAt    DateTime?
  approvedAt    DateTime?
  adminNotes    String?
  rejectionReason String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("RouteCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("RouteReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  globalRoute Route?   @relation("GlobalRouteLink", fields: [globalRouteId], references: [id], onDelete: SetNull)
  linkedCompanyRoutes Route[] @relation("GlobalRouteLink")
  stops   RouteStop[]
  history RouteHistory[]
  buses   Bus[]
  trips   Trip[]

  @@index([companyId])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
  @@index([globalRouteId])
  @@index([sourceType])
  @@index([approvalStatus])
  @@index([isActive])
  @@schema("busapp")
}

model RouteHistory {
  id              String                 @id @default(uuid())
  routeId         String
  versionNumber   Int
  snapshotJson    Json
  snapshotHash    String
  actionType      RouteHistoryActionType
  approvalStatus  RouteApprovalStatus
  changedByUserId String?
  reviewByUserId  String?
  createdAt       DateTime               @default(now())

  route         Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  changedByUser User?  @relation("RouteHistoryChangedByUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  reviewedBy    User?  @relation("RouteHistoryReviewedByUser", fields: [reviewByUserId], references: [id], onDelete: SetNull)

  @@unique([routeId, versionNumber])
  @@index([routeId])
  @@index([changedByUserId])
  @@index([reviewByUserId])
  @@index([actionType])
  @@index([approvalStatus])
  @@index([createdAt])
  @@schema("busapp")
}

model RouteStop {
  id        String         @id @default(uuid())
  routeId   String
  direction RouteDirection
  stopName  String
  stopOrder Int
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  route      Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  tripStarts Trip[] @relation("TripStartStop")
  tripEnds   Trip[] @relation("TripEndStop")

  @@unique([routeId, direction, stopOrder])
  @@index([routeId])
  @@index([direction])
  @@index([isActive])
  @@schema("busapp")
}

model Bus {
  id                 String    @id @default(uuid())
  companyId          String
  registrationNumber String
  busName            String?
  ntcPermitNumber    String?
  permitExpiry       DateTime?
  insuranceExpiry    DateTime?
  routeId            String?
  seatCount          Int?
  status             BusStatus @default(ACTIVE)
  defaultDriverStaffId    String?
  defaultConductorStaffId String?
  wageModel            WageModel @default(PERCENTAGE)
  driverPercentage     Decimal?  @db.Decimal(5, 2)
  conductorPercentage  Decimal?  @db.Decimal(5, 2)
  fixedDriverWage      Decimal?  @db.Decimal(12, 2)
  fixedConductorWage   Decimal?  @db.Decimal(12, 2)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  route       Route?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  defaultDriver    StaffProfile? @relation("BusDefaultDriver", fields: [defaultDriverStaffId], references: [id], onDelete: SetNull)
  defaultConductor StaffProfile? @relation("BusDefaultConductor", fields: [defaultConductorStaffId], references: [id], onDelete: SetNull)
  assignments BusAssignment[]
  accessPins  BusAccessPin[]
  trips       Trip[]
  operationalExpenses OperationalExpense[]
  operationalIncomes  OperationalIncome[]
  summaries   DailySummary[]

  @@unique([companyId, registrationNumber])
  @@index([companyId])
  @@index([routeId])
  @@index([status])
  @@index([defaultDriverStaffId])
  @@index([defaultConductorStaffId])
  @@index([isActive])
  @@schema("busapp")
}

model OperationalExpense {
  id            String          @id @default(uuid())
  companyId     String
  busId         String
  /** Business date (stored as UTC midnight for the selected local date). */
  recordDate    DateTime
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  note          String?
  enteredByType String          @default("dashboard")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([busId])
  @@index([recordDate])
  @@index([category])
  @@schema("busapp")
}

model OperationalIncome {
  id            String             @id @default(uuid())
  companyId     String
  busId         String
  /** Business date (stored as UTC midnight for the selected local date). */
  recordDate    DateTime
  category      ExtraIncomeCategory
  amount        Decimal            @db.Decimal(12, 2)
  note          String?
  enteredByType String             @default("dashboard")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([busId])
  @@index([recordDate])
  @@index([category])
  @@schema("busapp")
}

model BusAssignment {
  id               String           @id @default(uuid())
  companyId        String
  busId            String
  assignmentDate   DateTime
  driverStaffId    String?
  conductorStaffId String?
  assignedByUserId String
  status           AssignmentStatus @default(ASSIGNED)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bus        Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver     StaffProfile?  @relation("DriverAssignment", fields: [driverStaffId], references: [id], onDelete: SetNull)
  conductor  StaffProfile?  @relation("ConductorAssignment", fields: [conductorStaffId], references: [id], onDelete: SetNull)
  assignedBy User           @relation("AssignedByUser", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  accessPins BusAccessPin[]
  trips      Trip[]
  summaries  DailySummary[]

  @@unique([busId, assignmentDate])
  @@index([companyId])
  @@index([busId])
  @@index([assignmentDate])
  @@index([driverStaffId])
  @@index([conductorStaffId])
  @@index([status])
  @@schema("busapp")
}

model BusAccessPin {
  id              String    @id @default(uuid())
  busId           String
  assignmentId    String?
  pinHash         String
  isActive        Boolean   @default(true)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bus        Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  assignment BusAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdBy  User           @relation("PinCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([busId])
  @@index([assignmentId])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
  @@schema("busapp")
}

model Trip {
  id               String         @id @default(uuid())
  companyId        String
  busId            String
  assignmentId     String?
  routeId          String?
  tripDate         DateTime
  tripNumber       Int
  direction        RouteDirection
  startStopId      String?
  endStopId        String?
  driverStaffId    String?
  conductorStaffId String?
  startedAt        DateTime?
  endedAt          DateTime?
  status           TripStatus     @default(NOT_STARTED)
  createdVia       String         @default("bus_app")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bus       Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  assignment BusAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  route     Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  startStop RouteStop?     @relation("TripStartStop", fields: [startStopId], references: [id], onDelete: SetNull)
  endStop   RouteStop?     @relation("TripEndStop", fields: [endStopId], references: [id], onDelete: SetNull)
  driver    StaffProfile?  @relation("TripDriver", fields: [driverStaffId], references: [id], onDelete: SetNull)
  conductor StaffProfile?  @relation("TripConductor", fields: [conductorStaffId], references: [id], onDelete: SetNull)
  incomes   TripIncome[]
  expenses  TripExpense[]
  extraIncomes ExtraIncome[]

  @@unique([busId, tripDate, tripNumber])
  @@index([companyId])
  @@index([busId])
  @@index([assignmentId])
  @@index([routeId])
  @@index([tripDate])
  @@index([status])
  @@index([direction])
  @@index([driverStaffId])
  @@index([conductorStaffId])
  @@schema("busapp")
}

model TripIncome {
  id            String   @id @default(uuid())
  tripId        String
  amount        Decimal  @db.Decimal(12, 2)
  note          String?
  enteredByType String   @default("bus_app")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@schema("busapp")
}

model ExtraIncome {
  id            String               @id @default(uuid())
  tripId        String
  category      ExtraIncomeCategory
  amount        Decimal              @db.Decimal(12, 2)
  note          String?
  enteredByType String               @default("bus_app")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([category])
  @@schema("busapp")
}

model TripExpense {
  id              String          @id @default(uuid())
  tripId          String
  expenseCategory ExpenseCategory
  amount          Decimal         @db.Decimal(12, 2)
  note            String?
  enteredByType   String          @default("bus_app")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([expenseCategory])
  @@schema("busapp")
}

model DailySummary {
  id               String             @id @default(uuid())
  companyId        String
  busId            String
  assignmentId     String?
  summaryDate      DateTime
  totalTrips       Int                @default(0)
  totalIncome      Decimal            @default(0) @db.Decimal(12, 2)
  totalExpenses    Decimal            @default(0) @db.Decimal(12, 2)
  dti              Decimal            @default(0) @db.Decimal(12, 2)
  driverSalary     Decimal            @default(0) @db.Decimal(12, 2)
  conductorSalary  Decimal            @default(0) @db.Decimal(12, 2)
  netAmount        Decimal            @default(0) @db.Decimal(12, 2)
  wageModelSnapshot    String?
  driverPctSnapshot    Decimal?           @db.Decimal(5, 2)
  conductorPctSnapshot Decimal?           @db.Decimal(5, 2)
  status           DailySummaryStatus @default(DRAFT)
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bus        Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  assignment BusAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  approvedBy User?          @relation("SummaryApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([busId, summaryDate])
  @@index([companyId])
  @@index([busId])
  @@index([assignmentId])
  @@index([summaryDate])
  @@index([status])
  @@schema("busapp")
}

/// Company-level configuration. One row per company, created lazily on first access.
model CompanySettings {
  id        String  @id @default(uuid())
  companyId String  @unique

  /// Default driver wage percentage (used as a hint when creating new buses)
  defaultDriverPercentage     Decimal? @db.Decimal(5, 2)
  /// Default conductor wage percentage
  defaultConductorPercentage  Decimal? @db.Decimal(5, 2)
  /// Default fixed daily driver wage (Rs.)
  defaultFixedDriverWage      Decimal? @db.Decimal(12, 2)
  /// Default fixed daily conductor wage (Rs.)
  defaultFixedConductorWage   Decimal? @db.Decimal(12, 2)
  /// Warn on settlement screen if driver% + conductor% exceeds this value
  maxCombinedPercentageWarning Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@schema("busapp")
}

model Notification {
  id                String               @id @default(uuid())
  companyId         String
  userId            String?
  type              String
  title             String
  message           String
  severity          NotificationSeverity @default(INFO)
  relatedEntityType String?
  relatedEntityId   String?
  targetUrl         String?
  isRead            Boolean              @default(false)
  readAt            DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([companyId, userId, isRead])
  @@schema("busapp")
}
